{
    "name": "@degreesign/voice",
    "version": "0.1.1",
    "description": "Offline speech recognition and transcription for the browser and Node.js with the SenseVoice and Whisper models",
    "main": "dist/node/degreesign.node.min.js",
    "browser": "dist/browser/degreesign.min.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc --emitDeclarationOnly && webpack",
        "typecheck": "tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DegreeSign/ds_voice.git"
    },
    "keywords": [
        "speech recognition",
        "speech to text",
        "transcription",
        "asr",
        "whisper",
        "sensevoice",
        "offline",
        "on-device",
        "typescript",
        "browser",
        "nodejs",
        "degreesign"
    ],
    "author": "DegreeSign",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/DegreeSign/ds_voice/issues"
    },
    "homepage": "https://github.com/DegreeSign/ds_voice#readme",
    "engines": {
        "node": ">=24"
    },
    "files": [
        "dist/"
    ],
    "dependencies": {
        "@degreesign/cache": "1.0.0",
        "@degreesign/storage": "1.1.5"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "terser-webpack-plugin": "^5.3.11",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.0",
        "webpack": "^5.97.1",
        "webpack-cli": "^6.0.1"
    }
}

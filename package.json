{
    "name": "@degreesign/voice",
    "version": "2.3.2",
    "description": "Offline dictation, speech to text and text to speech (TTS) for web and Node.js",
    "main": "dist/node/degreesign.node.min.js",
    "browser": "dist/browser/degreesign.min.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "browser": "./dist/browser/degreesign.min.js",
            "default": "./dist/node/degreesign.node.min.js"
        },
        "./dictation": {
            "types": "./dist/transcription/dictation/index.d.ts",
            "default": "./dist/browser/dictation.min.js"
        },
        "./dictation/worker": "./dist/browser/dictation.worker.js",
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "dictation": [
                "dist/transcription/dictation/index.d.ts"
            ]
        }
    },
    "scripts": {
        "build": "tsc --emitDeclarationOnly && webpack && node scripts/copy-assets.cjs",
        "typecheck": "tsc --noEmit",
        "samples": "node scripts/embed-voice-samples.cjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DegreeSign/ds_voice.git"
    },
    "keywords": [
        "speech recognition",
        "speech to text",
        "transcription",
        "dictation",
        "voice notes",
        "asr",
        "whisper",
        "offline",
        "on-device",
        "private",
        "typescript",
        "browser",
        "nodejs",
        "degreesign",
        "text to speech",
        "speech synthesis",
        "tts"
    ],
    "author": "DegreeSign",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "bugs": {
        "url": "https://github.com/DegreeSign/ds_voice/issues"
    },
    "homepage": "https://github.com/DegreeSign/ds_voice#readme",
    "engines": {
        "node": ">=24"
    },
    "files": [
        "dist/"
    ],
    "dependencies": {
        "@degreesign/cache": "1.0.0",
        "@degreesign/storage": "1.1.5"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "terser-webpack-plugin": "^5.3.11",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.0",
        "webpack": "^5.97.1",
        "webpack-cli": "^6.0.1"
    }
}
